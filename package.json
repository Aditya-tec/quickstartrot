{
  "name": "quickstartrot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qsr": "turbo run build --filter=@qsr/cli... --output-logs=errors-only && node packages/cli/dist/main.js",
    "prepare": "husky",
    "secrets:check": "node scripts/secrets-check.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "smoke:api": "turbo run build --filter=@qsr/cli... --output-logs=errors-only && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/smoke-api.ts",
    "probe:local": "turbo run build --filter=@qsr/cli... --filter=@qsr/api... --output-logs=errors-only && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/probe-local.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  }
}
