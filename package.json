{
  "name": "quickstartrot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qsr": "turbo run build --filter=@qsr/cli... --output-logs=errors-only && node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
