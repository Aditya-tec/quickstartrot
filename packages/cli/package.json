{
  "name": "@qsr/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@qsr/classifier": "workspace:*",
    "@qsr/compiler": "workspace:*",
    "@qsr/core": "workspace:*",
    "@qsr/crawler": "workspace:*",
    "@qsr/executor": "workspace:*",
    "@qsr/status": "workspace:*",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "qsr": "./dist/main.js"
  }
}
