{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": ["NEXT_PUBLIC_*", "QSR_DATA"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "QSR_REQUIRE_DOCKER",
        "QSR_SKIP_DOCKER_TESTS",
        "QSR_REQUIRE_DB",
        "QSR_TEST_DATABASE_URL"
      ]
    }
  }
}
